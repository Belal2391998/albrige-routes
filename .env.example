# ASP.NET Core API (SQLite backend) — set to enable live database sync
# Local development (HTTP, no certificate setup required)
VITE_API_BASE_URL=http://localhost:5000

# Local development over HTTPS (run `dotnet dev-certs https --trust` first)
# VITE_API_BASE_URL=https://localhost:5001

# Production — replace with your deployed backend URL
# VITE_API_BASE_URL=https://api.your-domain.com
